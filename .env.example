# Environment Variables Template
# Copy this file to .env and fill in your values

# Flask Secret Key (generate a random string)
SECRET_KEY=your-super-secret-key-change-this

# Local SQLite development mode (Set to true to use SQLite without PostgreSQL/Supabase)
USE_SQLITE=true

# Supabase PostgreSQL Database URL (used when USE_SQLITE is false or empty)
# Get this from: Supabase Dashboard → Settings → Database → Connection string (URI)
# IMPORTANT: Replace 'postgres://' with 'postgresql://'
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# Admin Credentials (used for initial database seeding)
ADMIN_EMAIL=admin@sarvagyaan.com
ADMIN_PASSWORD=your-secure-password

# Optional: School Profile for Receipts and Reports
SCHOOL_NAME=PM SHRI Kendriya Vidyalaya
SCHOOL_TAGLINE=Empowering Minds, Inspiring Futures
SCHOOL_ADDRESS=Ordnance Factory Estate, Itarsi
SCHOOL_PHONE=+91 98765 43210
SCHOOL_EMAIL=admin@amrita.com
SCHOOL_AFFILIATION=CBSE / SGA-2024-889

# Google Gemini API Key (optional - core fee management runs without this)
GEMINI_API_KEY=your-gemini-api-key
